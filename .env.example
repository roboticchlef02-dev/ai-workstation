# Copy to .env (never committed) OR set these as environment variables.
# In a Claude Code cloud environment, set them in the environment's settings, not in a file.
# Leave values empty here. Never paste real keys into this file.

# --- Providers (set only the ones you use) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# --- Spend control ---
# Hard cap for any single command that calls a paid API (USD).
MAX_RUN_COST_USD=5
# Total experiment budget (USD). Set after Phase 0 answers.
TOTAL_EXPERIMENT_BUDGET_USD=

# --- Mode ---
# mock | replay | live   (live requires --confirm-spend on every command)
AIWS_PROVIDER_MODE=mock
