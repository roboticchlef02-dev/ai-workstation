# --- Secrets (never commit) ---
# No trailing slashes: also covers files and symlinks with these names.
.env
.env.*
.envrc
!.env.example
secrets
*.pem
*.key
id_rsa*
id_ed25519*
credentials.json

# --- Held-out benchmark: never in git, never opened during development ---
# Covers the directory, a symlink or file of that name, and archives (held_out.tar.gz).
benchmarks/held_out*

# --- Experiment state / results (decided per phase; see docs/QUESTIONS.md Q7) ---
*.sqlite
*.sqlite3
*.db
replay_cache/

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Editors / OS ---
.DS_Store
Thumbs.db
.idea/
.vscode/

# --- Claude Code local overrides ---
.claude/settings.local.json
